# know-infra environment -- copy to .env, fill in, then chmod 600 .env

# --- Grafana ------------------------------------------------------------
# Security: set a real password before exposing beyond localhost.
# Anonymous admin (old default) let any LAN client control Grafana.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ANON_ENABLED=false
GRAFANA_ANON_ROLE=Viewer

# --- Host port mappings ------------------------------------------------
# Change these if the defaults conflict with other services on the host.
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
ALLOY_PORT=12345

# --- Docker network ----------------------------------------------------
# Change if 172.20.0.0/24 conflicts with existing Docker networks.
DOCKER_SUBNET=172.20.0.0/24

# --- Container name prefix ---------------------------------------------
# Useful when running multiple stacks (e.g. dev-know-*, prod-know-*)
# on the same VM. Single stack: leave as "know".
STACK_PREFIX=know

# --- Tuning ------------------------------------------------------------
# Trace sampling: 10% at current volume, raise/lower based on cost.
SAMPLING_PERCENTAGE=10

# Retention: Loki for logs, Tempo for traces. Both are "duration" strings.
LOKI_RETENTION_PERIOD=720h
TEMPO_BLOCK_RETENTION=168h

# Loki auth: false = open (LAN-only, current setup). true = requires auth
# (needed before exposing port 3100 beyond LAN).
LOKI_AUTH_ENABLED=false