{
	"uid": "know-logs",
	"title": "Know Logs",
	"description": "Loki logs for Know services",
	"tags": [
		"know",
		"logs",
		"loki"
	],
	"timezone": "browser",
	"schemaVersion": 39,
	"version": 2,
	"editable": true,
	"graphTooltip": 1,
	"time": {
		"from": "now-1h",
		"to": "now"
	},
	"timepicker": {},
	"templating": {
		"list": [
			{
				"name": "service_name",
				"type": "query",
				"label": "Service",
				"datasource": {
					"type": "loki",
					"uid": "loki"
				},
				"query": "label_values(service_name)",
				"includeAll": true,
				"multi": true,
				"refresh": 2,
				"allValue": ".+",
				"current": {
					"text": "All",
					"value": "$__all"
				}
			},
			{
				"name": "task_id",
				"type": "textbox",
				"label": "Task ID",
				"current": {
					"text": "",
					"value": ""
				}
			},
			{
				"name": "trace_id",
				"type": "textbox",
				"label": "Trace ID",
				"current": {
					"text": "",
					"value": ""
				}
			}
		]
	},
	"panels": [
		{
			"id": 1,
			"type": "timeseries",
			"title": "Log volume by service_name",
			"gridPos": {
				"h": 7,
				"w": 12,
				"x": 0,
				"y": 0
			},
			"datasource": {
				"type": "loki",
				"uid": "loki"
			},
			"targets": [
				{
					"refId": "A",
					"expr": "sum by (service_name) (count_over_time({service_name=~\"$service_name\"}[1m]))",
					"legendFormat": "{{service_name}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"custom": {
						"fillOpacity": 15,
						"spanNulls": true
					}
				}
			}
		},
		{
			"id": 2,
			"type": "timeseries",
			"title": "Log volume by level",
			"gridPos": {
				"h": 7,
				"w": 12,
				"x": 12,
				"y": 0
			},
			"datasource": {
				"type": "loki",
				"uid": "loki"
			},
			"targets": [
				{
					"refId": "A",
					"expr": "sum by (detected_level) (count_over_time({service_name=~\"$service_name\"} [1m]))",
					"legendFormat": "{{detected_level}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"custom": {
						"fillOpacity": 15,
						"spanNulls": true
					}
				}
			}
		},
		{
			"id": 3,
			"type": "logs",
			"title": "Recent logs",
			"gridPos": {
				"h": 12,
				"w": 24,
				"x": 0,
				"y": 7
			},
			"datasource": {
				"type": "loki",
				"uid": "loki"
			},
			"targets": [
				{
					"refId": "A",
					"expr": "{service_name=~\"$service_name\"}"
				}
			],
			"options": {
				"showTime": true,
				"showLabels": true,
				"showCommonLabels": false,
				"wrapLogMessage": true,
				"prettifyLogMessage": false,
				"enableLogDetails": true,
				"sortOrder": "Descending"
			}
		},
		{
			"id": 4,
			"type": "logs",
			"title": "Errors",
			"gridPos": {
				"h": 10,
				"w": 24,
				"x": 0,
				"y": 19
			},
			"datasource": {
				"type": "loki",
				"uid": "loki"
			},
			"targets": [
				{
					"refId": "A",
					"expr": "{service_name=~\"$service_name\"} |~ \"(?i)error|failed|panic|fatal\""
				}
			],
			"options": {
				"showTime": true,
				"showLabels": true,
				"wrapLogMessage": true,
				"enableLogDetails": true,
				"sortOrder": "Descending"
			}
		},
		{
			"id": 5,
			"type": "logs",
			"title": "Filter by task_id (fill variable)",
			"gridPos": {
				"h": 10,
				"w": 12,
				"x": 0,
				"y": 29
			},
			"datasource": {
				"type": "loki",
				"uid": "loki"
			},
			"targets": [
				{
					"refId": "A",
					"expr": "{service_name=~\"$service_name\"} | task_id!=\"\" | task_id=`$task_id`"
				}
			],
			"options": {
				"showTime": true,
				"showLabels": true,
				"wrapLogMessage": true,
				"enableLogDetails": true,
				"sortOrder": "Descending"
			}
		},
		{
			"id": 6,
			"type": "logs",
			"title": "Filter by trace_id (fill variable)",
			"gridPos": {
				"h": 10,
				"w": 12,
				"x": 12,
				"y": 29
			},
			"datasource": {
				"type": "loki",
				"uid": "loki"
			},
			"targets": [
				{
					"refId": "A",
					"expr": "{service_name=~\"$service_name\"} | trace_id!=\"\" | trace_id=`$trace_id`"
				}
			],
			"options": {
				"showTime": true,
				"showLabels": true,
				"wrapLogMessage": true,
				"enableLogDetails": true,
				"sortOrder": "Descending"
			}
		},
		{
			"id": 7,
			"type": "timeseries",
			"title": "Error log rate by service",
			"gridPos": {
				"h": 7,
				"w": 12,
				"x": 0,
				"y": 39
			},
			"datasource": {
				"type": "loki",
				"uid": "loki"
			},
			"targets": [
				{
					"refId": "A",
					"expr": "sum by (service_name) (count_over_time({service_name=~\"$service_name\"} |~ \"(?i)error\" [1m]))",
					"legendFormat": "{{service_name}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"custom": {
						"fillOpacity": 20
					}
				}
			}
		},
		{
			"id": 8,
			"type": "logs",
			"title": "Task lifecycle events",
			"gridPos": {
				"h": 10,
				"w": 24,
				"x": 0,
				"y": 46
			},
			"datasource": {
				"type": "loki",
				"uid": "loki"
			},
			"targets": [
				{
					"refId": "A",
					"expr": "{service_name=~\"$service_name\"} |~ \"task_enqueued|task_claimed|task_finished\""
				}
			],
			"options": {
				"showTime": true,
				"showLabels": true,
				"wrapLogMessage": true,
				"enableLogDetails": true,
				"sortOrder": "Descending"
			}
		},
		{
			"id": 9,
			"type": "logs",
			"title": "OTEL invalid attribute warnings",
			"gridPos": {
				"h": 8,
				"w": 24,
				"x": 0,
				"y": 56
			},
			"datasource": {
				"type": "loki",
				"uid": "loki"
			},
			"targets": [
				{
					"refId": "A",
					"expr": "{service_name=~\"$service_name\"} |~ \"Invalid type\" |~ \"attribute value\""
				}
			],
			"options": {
				"showTime": true,
				"wrapLogMessage": true,
				"enableLogDetails": true,
				"sortOrder": "Descending"
			}
		}
	]
}